# Sahi-Sahi FORMS frontend (build-time). Placeholders only.
# Public URL of the forms API. Leave empty locally (Vite proxies /api to localhost:4000).
VITE_API_URL=https://surveyforms.onrender.com
# Main website, used for the "Back to Sahi-Sahi" links.
VITE_MAIN_SITE_URL=https://sahisahi.com
# Firebase web config for mobile OTP. Firebase Console -> Project settings -> General -> Your apps -> Web app.
# These are public identifiers (shipped in the browser bundle): never put secrets or service-account JSON in VITE_* vars.
VITE_FIREBASE_API_KEY=
# The four below default to the sahisahi-a19b8 project in src/lib/firebase.ts; set them only to override.
VITE_FIREBASE_AUTH_DOMAIN=sahisahi-a19b8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sahisahi-a19b8
VITE_FIREBASE_APP_ID=1:1027210943350:web:1025f67d708afaed213857
VITE_FIREBASE_MESSAGING_SENDER_ID=1027210943350
