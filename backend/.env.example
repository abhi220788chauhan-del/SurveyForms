# Sahi-Sahi FORMS backend. Placeholders only - never commit real credentials.
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=1

# SAME MongoDB as the main Sahi-Sahi backend (the forms use their own collections in it).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
# MONGODB_DB_NAME=sahisahi

# Email verification (OTP). Secret signs the "email verified" token: 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FORMS_SECRET=
# SMTP server that sends the verification code (e.g. Gmail app password, Brevo, SES, Zoho).
# Without SMTP_HOST (development only) the code is printed in the server console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sahi-Sahi <no-reply@sahisahi.com>"

# Origin(s) of the forms website, comma-separated (CORS).
FRONTEND_URL=https://forms.sahisahi.com
# ALLOWED_ORIGINS=https://staging-forms.sahisahi.com

# Firebase project used for mobile OTP (the browser does the SMS step; the API verifies the ID token).
FIREBASE_PROJECT_ID=sahisahi-a19b8
